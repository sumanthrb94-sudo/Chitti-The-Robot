# Claude / Anthropic API key — required
ANTHROPIC_API_KEY=sk-ant-...

# Default Claude model (Opus/Sonnet/Haiku 4.x)
CHITTI_MODEL=claude-sonnet-4-6

# Optional: ElevenLabs for premium TTS (falls back to browser TTS if unset)
ELEVENLABS_API_KEY=

# Optional: Tavily/Serper for web search tool (falls back to disabled if unset)
TAVILY_API_KEY=
