# ─────────────────────────────────────────────────────────────
#  Chitti — LLM provider configuration
#  Pick ONE of: anthropic (proprietary Claude) or ollama (open-source local).
# ─────────────────────────────────────────────────────────────

# Selection: anthropic | ollama
# If unset:
#   - ANTHROPIC_API_KEY present -> anthropic
#   - otherwise                 -> ollama
LLM_PROVIDER=

# ── Option A: Anthropic Claude (default if API key is set) ──
ANTHROPIC_API_KEY=
# Model id — Opus 4.7 / Sonnet 4.6 / Haiku 4.5 etc.
CHITTI_MODEL=claude-sonnet-4-6

# ── Option B: Ollama — fully open-source, runs locally ──
# Install: https://ollama.com  →  `ollama pull llama3.1:8b`
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Pick any model that supports tool calling.
# Recommended: llama3.1:8b, qwen2.5:7b, mistral-nemo
OLLAMA_MODEL=llama3.1:8b

# ── DB mode (auto-detected on Vercel; leave empty locally) ──
# CHITTI_DB_MODE=memory
