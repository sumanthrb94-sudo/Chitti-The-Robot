# ─────────────────────────────────────────────────────────────
#  Chitti — LLM provider configuration
#  Pick ONE of: anthropic | openai | ollama
# ─────────────────────────────────────────────────────────────

# Force a specific provider. Leave blank to auto-detect:
#   OPENAI_API_KEY present    -> openai
#   ANTHROPIC_API_KEY present -> anthropic
#   otherwise                 -> ollama
LLM_PROVIDER=

# ── Option A: Anthropic Claude (hosted) ──
ANTHROPIC_API_KEY=
# Opus 4.7 / Sonnet 4.6 / Haiku 4.5 etc.
CHITTI_MODEL=claude-sonnet-4-6

# ── Option B: OpenAI-compatible (Kimi / OpenAI / OpenRouter / Groq / DeepSeek / vLLM) ──
# One env var triplet handles all of them — just change OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
#
# Examples (uncomment one):
#   Kimi / Moonshot:
#     OPENAI_BASE_URL=https://api.moonshot.ai/v1
#     OPENAI_MODEL=kimi-k2-0905-preview
#   OpenRouter:
#     OPENAI_BASE_URL=https://openrouter.ai/api/v1
#     OPENAI_MODEL=anthropic/claude-sonnet-4-5
#   Groq:
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_MODEL=llama-3.3-70b-versatile
#   DeepSeek:
#     OPENAI_BASE_URL=https://api.deepseek.com/v1
#     OPENAI_MODEL=deepseek-chat

# ── Option C: Ollama (fully open-source, runs locally) ──
# Install: https://ollama.com  →  `ollama pull llama3.1:8b`
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Recommended models with tool calling: llama3.1:8b, qwen2.5:7b, mistral-nemo
OLLAMA_MODEL=llama3.1:8b

# ── DB mode (auto-detected on Vercel; leave empty locally) ──
# CHITTI_DB_MODE=memory
